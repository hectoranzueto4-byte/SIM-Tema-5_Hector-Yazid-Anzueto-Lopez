    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_Enfriar" targetRef="Activity_Calidad" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_Calidad" targetRef="Gateway_Calidad" />
